# RepairDom - Backend
# Copier ce fichier en `.env` et remplacer par vos vraies valeurs.
# Ne JAMAIS committer le fichier `.env`.

# Environnement : development | production | test
NODE_ENV=development

# Port HTTP de l'API
PORT=3000

# PostgreSQL (utilisé par Prisma pour les migrations et le client).
# Exemple local : postgresql://postgres:postgres@localhost:5432/repairdom
# Sur Railway, le provider PostgreSQL injecte automatiquement une variable DATABASE_URL.
DATABASE_URL=votre_url_postgresql

# Origines autorisées pour le CORS, séparées par des virgules.
# Laisser vide pour refléter toutes les origines (développement local).
# Production (Vercel) :
# CORS_ORIGINS=https://repairdom-frontend.vercel.app
CORS_ORIGINS=

# Secret de signature JWT (obligatoire en production pour des sessions stables).
# Générer : openssl rand -base64 48
# En l'absence de valeur, une clé aléatoire est générée au démarrage
# (les sessions sont alors réinitialisées à chaque redéploiement).
JWT_SECRET=

# Durée de validité d'un jeton JWT (format jsonwebtoken, ex. : 7d, 12h).
JWT_EXPIRES_IN=7d

# Vérification e-mail via Resend (API HTTPS, pas SMTP).
# En production (Railway → Variables), définir RESEND_API_KEY (clé secrète
# Resend, jamais committée). Sans elle, les liens de vérification sont
# seulement journalisés et l'inscription reste fonctionnelle.
RESEND_API_KEY=

# Adresse d'expédition (prioritaire sur SMTP_FROM).
# Premier fonctionnement : Relio <onboarding@resend.dev> (expéditeur de test
# officiel Resend, sans domaine vérifié — la réception est alors limitée par
# Resend aux adresses autorisées en mode test).
# Adresse définitive : définir EMAIL_FROM vers un domaine vérifié dans Resend
# (ex. : Relio <no-reply@relioo.space> — à créer côté Resend/domaine, jamais
# committée ici). Par défaut : Relio <onboarding@resend.dev>
EMAIL_FROM=

# URL publique du frontend Relio (liens des e-mails : vérification, dispatch).
# En production (Railway → Variables) : https://relioo.space
# Sans elle, les liens e-mail retombent sur https://relioo.space.
FRONTEND_URL=

# Stockage des fichiers via Supabase Storage (API HTTPS, pas de dépendance SDK).
# En production (Railway → Variables), définir les deux variables suivantes
# (valeurs du dashboard Supabase → Project Settings → API ; jamais committées).
# Format attendu : https://<ref>.supabase.co SANS slash final ni chemin.
# Sans elles, les uploads répondent 503 « stockage non configuré ».
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Mode financier Relio (serveur-authoritative, jamais décidé par le frontend).
# SIMULATION (défaut) : ledger de simulation, crédit de test ADMIN autorisé.
# REAL : recharges SasPay confirmées uniquement, crédit de test refusé.
# FINANCIAL_MODE=SIMULATION

# RECETTE PAYOUT (TEMPORAIRE, à supprimer après validation).
# Permet à POST /finances/withdrawals de franchir le contrôle de solde pour
# atteindre SasPay POST /payouts/initialize/ même à 0 XAF (ex. 1000 demandés).
# Défaut : désactivé (contrôle normal). Activer uniquement pour la recette :
# RECETTE_PAYOUT_BYPASS_BALANCE=true
# Hold ACTIVE + PENDING + idempotence conservés ; aucun débit ledger avant
# SUCCESS ; FAILED/CANCELLED libèrent le hold sans débit.

# SasPay — rail de paiement externe (Sprint SASPAY-01, fondations).
# Base API officielle : https://api.saspay.me/api/v1 (défaut si vide).
# SASPAY_BASE_URL=https://api.saspay.me/api/v1
# Mode prestataire (garde-fou interne Relio ; ne change pas l'endpoint
# SasPay — l'environnement est déterminé par la clé elle-même).
# TEST (défaut) : mode interne non-réel — aucun appel réel avec une clé
#   live (sk_live_…) ; une clé sk_test_… reste acceptée.
# LIVE : exige une clé sk_live_… (seule config autorisant le réel).
# SASPAY_MODE=TEST
# Clé API secrète (sk_test_… / sk_live_…) : backend UNIQUEMENT, jamais
# exposée au frontend, jamais committée. Sans elle, les opérations SasPay
# sont refusées proprement.
# SASPAY_API_KEY=
# Secret de signature des webhooks (X-Webhook-Signature = HMAC-SHA256
# timestamp + "." + rawBody). Sans lui, les webhooks répondent 401.
# SASPAY_WEBHOOK_SECRET=
# Relais payout VPS (sortie IP fixe, init payout uniquement, Railway uniquement).
# Si définie, `initializePayout()` POSTe au relay avec X-Relio-Relay-Secret
# (même Idempotency-Key, même body, SANS clé SasPay). Verify/webhooks/top-up
# restent directs : conserver SASPAY_API_KEY. Valeurs Railway uniquement,
# jamais committées, jamais exposées au frontend.
# SASPAY_PAYOUT_RELAY_URL=https://api.relioo.space/payout/initialize
# SASPAY_PAYOUT_RELAY_SECRET=