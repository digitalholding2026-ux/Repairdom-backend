# RepairDom - Backend
# Remplacer par les vraies valeurs du projet Supabase
SUPABASE_URL=votre_url
SUPABASE_ANON_KEY=votre_anon_key

# Secret utilisé pour signer les JSON Web Tokens (JWT) d'authentification.
# Renseigner une valeur longue et aléatoire (ex: openssl rand -hex 32).
JWT_SECRET=votre_secret_jwt

# Durée de validité des JWT (format jsonwebtoken, ex: 7d, 24h).
JWT_EXPIRES_IN=7d

# Commission RetailDom déduite de chaque mission (0.10 = 10%).
COMMISSION_RATE=0.10

# Origines autorisées pour le CORS (séparées par des virgules).
# À renseigner sur Railway si le domaine Vercel diffère du défaut.
# Exemple : https://repairdom.vercel.app,https://mon-domaine.com
# CORS_ORIGINS=https://repairdom.vercel.app