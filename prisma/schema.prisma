  problem       Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  interventions CatalogIntervention[]
  missionDiagnostics Diagnostic[]
  quotes         Quote[]

  @@unique([problemId, slug])
  @@index([problemId])
  @@index([isActive])
