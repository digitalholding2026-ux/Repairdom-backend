model Problem {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  domainId    String
  // Ancrage marque/modèle optionnel (Sprint 8.1) :
  //   - NULL/NULL   → problème générique du domaine ;
  //   - brandId set → problème spécifique à une marque ;
  //   - brandId+modelId set → problème spécifique à un modèle.
  brandId     String?
  modelId     String?
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain      ServiceDomain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  brand       DeviceBrand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  model       DeviceModel?        @relation(fields: [modelId], references: [id], onDelete: SetNull)
  diagnostics CatalogDiagnostic[]
  demandes    Demande[]

  // L'unicité effective du slug est scopée par (domainId, brandId, modelId) :
  // garantie par un INDEX UNIQUE FONCTIONNEL créé manuellement en migration
  // (Prisma n'exprime pas les index fonctionnels) :
  //   UNIQUE (domainId, COALESCE(brandId,''), COALESCE(modelId,''), slug)
  // La même contrainte est vérifiée au niveau applicatif dans
  // catalog.service.ts (createProblem / updateProblem).
  @@index([domainId])
  @@index([domainId, slug])
  @@index([brandId])
  @@index([modelId])
  @@index([isActive])
}

