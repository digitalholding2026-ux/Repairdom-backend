generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  TECHNICIAN
  ADMIN
}

enum DemandeStatus {
  SUBMITTED
  PENDING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  CANCELED
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

enum RequestTiming {
  ASAP
  SCHEDULED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocumentType {
  IDENTITY
  PROFESSIONAL
}

model User {
  id                  String              @id @default(dbgenerated("gen_random_uuid()"))
  role                Role                @default(CLIENT)
  firstName           String
  lastName            String?
  phone               String?
  email               String              @unique
  passwordHash        String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  demandes            Demande[]           @relation("ClientDemandes")
  technicianDemandes  Demande[]           @relation("TechnicianDemandes")
  technicianProfile   TechnicianProfile?
  kycDocuments        KycDocument[]
  kycReviewsMade      KycReview[]      @relation("KycReviewReviewer")
  kycReviews          KycReview[]      @relation("KycReviewTechnician")
  messages            Message[]
  diagnostics         Diagnostic[]
  quotes              Quote[]
  reviewsAuthored     Review[]     @relation("ReviewAuthor")
  reviewsReceived     Review[]     @relation("ReviewTarget")
  pricingHistories    PricingHistory[] @relation("PricingHistoryAuthor")
}

model Demande {
  id          String        @id @default(dbgenerated("gen_random_uuid()"))
  reference   String        @unique
  status      DemandeStatus @default(SUBMITTED)
  category    String
  description String
  city        String
  neighborhood String?
  address     String?
  landmark    String?
  contactPhone String?
  client      User          @relation("ClientDemandes", fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  technician  User?         @relation("TechnicianDemandes", fields: [technicianId], references: [id], onDelete: SetNull)
  technicianId String?
  scheduledAt DateTime?
  requestedMode RequestTiming @default(ASAP)
  requestedAt   DateTime?
  medias      DemandeMedia[]
  messages    Message[]
  diagnostics Diagnostic[]
  quotes      Quote[]
  reviews     Review[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([technicianId])
  @@index([status])
}

model TechnicianProfile {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city       String
  categories String[]
  isAvailable Boolean @default(false)
  avatarUrl  String?
  bio        String?
  experience String?
  serviceDescription String?
  specialties String[] @default([])
  kycStatus  KycStatus @default(NOT_SUBMITTED)
  kycRejectionReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KycDocument {
  id           String          @id @default(dbgenerated("gen_random_uuid()"))
  technicianId String
  type         KycDocumentType
  storagePath  String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime        @default(now())

  technician   User            @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId])
}

model KycReview {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  technicianId   String
  reviewerId     String
  previousStatus KycStatus
  newStatus      KycStatus
  reason         String?
  createdAt      DateTime  @default(now())

  technician User @relation("KycReviewTechnician", fields: [technicianId], references: [id], onDelete: Cascade)
  reviewer   User @relation("KycReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([technicianId])
  @@index([reviewerId])
}

model DemandeMedia {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  kind      MediaKind
  fileName  String
  mimeType  String
  sizeBytes Int
  stored    Boolean   @default(false)
  url       String?
  demande   Demande   @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  demandeId String
  createdAt DateTime  @default(now())

  @@index([demandeId])
}

model Message {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([demandeId])
  @@index([senderId])
}

model Diagnostic {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId      String
  technicianId   String
  content        String
  recommendation String?
  createdAt      DateTime @default(now())

  demande    Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([demandeId])
}

model Quote {
  id           String      @id @default(dbgenerated("gen_random_uuid()"))
  demandeId    String
  technicianId String
  amount       Int
  currency     String      @default("XAF")
  description  String
  status       QuoteStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  demande    Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([demandeId])
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId String
  authorId  String
  targetId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target  User    @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([demandeId, authorId])
  @@index([targetId])
}

/* ── Catalogue RepairDom ────────────────────────────────────────── */

model ServiceDomain {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems Problem[]

  @@index([isActive])
}

model Problem {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  domainId    String
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain      ServiceDomain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  diagnostics CatalogDiagnostic[]

  @@unique([domainId, slug])
  @@index([domainId])
  @@index([isActive])
}

model CatalogDiagnostic {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  problemId      String
  name           String
  slug           String
  description    String?
  confidence     String?
  difficulty     String?
  estimatedTime  String?
  internalNotes  String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  problem       Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  interventions CatalogIntervention[]

  @@unique([problemId, slug])
  @@index([problemId])
  @@index([isActive])
}

model CatalogIntervention {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  diagnosticId    String
  name            String
  slug            String
  description     String?
  difficulty      String?
  estimatedTime   String?
  needsParts      Boolean  @default(false)
  partsNote       String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  diagnostic CatalogDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
pricing Pricing?

  @@unique([diagnosticId, slug])
  @@index([diagnosticId])
  @@index([isActive])
}

model Pricing {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  interventionId  String
  minPrice        Int?
  referencePrice  Int?
  maxPrice        Int?
  technicianPrice Int?
  customerPrice   Int?
  travelFee       Int?
  serviceFee      Int?
  currency        String   @default("XAF")
  priceMode       String   @default("fixed")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  intervention CatalogIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  history      PricingHistory[]

  @@unique([interventionId])
  @@index([interventionId])
}

model PricingHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  pricingId       String
  adminId         String
  previousValues  Json
  newValues       Json
  reason          String?
  createdAt       DateTime @default(now())

  pricing Pricing   @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  user    User      @relation("PricingHistoryAuthor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([pricingId])
  @@index([adminId])
}