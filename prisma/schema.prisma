generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  TECHNICIAN
  ADMIN
}

enum DemandeStatus {
  SUBMITTED
  PENDING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  CANCELED
}

// Sprint 8.3 : journal métier des missions.
enum DemandeEventType {
  CREATED
  TECHNICIAN_ASSIGNED
  TECHNICIAN_ACCEPTED
  DIAGNOSTIC_SELECTED
  // Sprint 8.4 : trace dédiée du diagnostic non référencé (déclaré librement),
  // distincte du DIAGNOSTIC_SELECTED du catalogue.
  MANUAL_DIAGNOSTIC_DECLARED
  QUOTE_CREATED
  NEGOTIATION_REQUESTED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  CANCELED
}

// Sprint 8.3 : notifications applicatives (créées uniquement par le backend).
enum NotificationType {
  TECHNICIAN_ACCEPTED
  QUOTE_CREATED
  NEGOTIATION_REQUESTED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  SCHEDULED
  COMPLETED
  CONFIRMED
}

// Sprint 8.4 — Gouvernance du diagnostic : origine d'un diagnostic de mission.
// CATALOG : diagnostic sélectionné dans le catalogue RepairDom (pricing auto).
// MANUAL : « diagnostic non référencé », déclaré librement par le technicien
// (intervention proposée + justification + note libre) avec tarif manuel.
enum DiagnosticMode {
  CATALOG
  MANUAL
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

enum RequestTiming {
  ASAP
  SCHEDULED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Sprint 8.6 — Origine d'un tarif.
// CATALOG : tarif automatique RepairDom, généré depuis le Pricing catalogue
//           (snapshot figé, indépendant des modifications ultérieures).
// MANUAL  : tarif manuel, exclusivement lié à un « diagnostic non référencé ».
enum QuoteSource {
  CATALOG
  MANUAL
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocumentType {
  IDENTITY
  PROFESSIONAL
}

model User {
  id                  String              @id @default(dbgenerated("gen_random_uuid()"))
  role                Role                @default(CLIENT)
  firstName           String
  lastName            String?
  phone               String?
  email               String              @unique
  passwordHash        String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  demandes            Demande[]           @relation("ClientDemandes")
  technicianDemandes  Demande[]           @relation("TechnicianDemandes")
  technicianProfile   TechnicianProfile?
  kycDocuments        KycDocument[]
  kycReviewsMade      KycReview[]      @relation("KycReviewReviewer")
  kycReviews          KycReview[]      @relation("KycReviewTechnician")
  messages            Message[]
  diagnostics         Diagnostic[]
  quotes              Quote[]
  reviewsAuthored     Review[]     @relation("ReviewAuthor")
  reviewsReceived     Review[]     @relation("ReviewTarget")
  pricingHistories    PricingHistory[] @relation("PricingHistoryAuthor")
  demandeEvents       DemandeEvent[]
  notifications       Notification[]
}

model Demande {
  id          String        @id @default(dbgenerated("gen_random_uuid()"))
  reference   String        @unique
  status      DemandeStatus @default(SUBMITTED)
  category    String
  description String
  city        String
  neighborhood String?
  address     String?
  landmark    String?
  contactPhone String?
  client      User          @relation("ClientDemandes", fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  technician  User?         @relation("TechnicianDemandes", fields: [technicianId], references: [id], onDelete: SetNull)
  technicianId String?
  scheduledAt DateTime?
  requestedMode RequestTiming @default(ASAP)
  requestedAt   DateTime?
  // Contexte matériel issu du catalogue (Sprint 8.1) — optionnel pour rester
  // compatible avec les demandes créées avant l'arrivée du catalogue.
  domain ServiceDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  domainId String?
  brand   DeviceBrand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId String?
  model   DeviceModel?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
  modelId String?
  problem Problem?       @relation(fields: [problemId], references: [id], onDelete: SetNull)
  problemId String?
  // Négociation (Sprint 8.1) : le chat de négociation n'est ouvert qu'après
  // la demande explicite du client (negotiationRequestedAt).
  negotiationRequestedAt DateTime?
  // Traçabilité : montant final accepté (quote ACCEPTED) de la mission.
  finalAmount Int?
  medias      DemandeMedia[]
  messages    Message[]
  diagnostics Diagnostic[]
  quotes      Quote[]
  reviews     Review[]
  events      DemandeEvent[]
  notifications Notification[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([technicianId])
  @@index([status])
  @@index([domainId])
  @@index([brandId])
  @@index([modelId])
  @@index([problemId])
}

model DemandeEvent {
  id          String          @id @default(dbgenerated("gen_random_uuid()"))
  demandeId   String
  actorUserId String?
  type        DemandeEventType
  fromStatus  DemandeStatus?
  toStatus    DemandeStatus?
  metadata    Json?
  createdAt   DateTime        @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([demandeId, createdAt])
  @@index([actorUserId])
}

model Notification {
  id        String          @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  demandeId String?
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime        @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  demande Demande? @relation(fields: [demandeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model TechnicianProfile {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city       String
  categories String[]
  isAvailable Boolean @default(false)
  avatarUrl  String?
  bio        String?
  experience String?
  serviceDescription String?
  specialties String[] @default([])
  kycStatus  KycStatus @default(NOT_SUBMITTED)
  kycRejectionReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KycDocument {
  id           String          @id @default(dbgenerated("gen_random_uuid()"))
  technicianId String
  type         KycDocumentType
  storagePath  String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime        @default(now())

  technician   User            @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId])
}

model KycReview {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  technicianId   String
  reviewerId     String
  previousStatus KycStatus
  newStatus      KycStatus
  reason         String?
  createdAt      DateTime  @default(now())

  technician User @relation("KycReviewTechnician", fields: [technicianId], references: [id], onDelete: Cascade)
  reviewer   User @relation("KycReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([technicianId])
  @@index([reviewerId])
}

model DemandeMedia {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  kind      MediaKind
  fileName  String
  mimeType  String
  sizeBytes Int
  stored    Boolean   @default(false)
  url       String?
  demande   Demande   @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  demandeId String
  createdAt DateTime  @default(now())

  @@index([demandeId])
}

model Message {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([demandeId])
  @@index([senderId])
}

model Diagnostic {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId      String
  technicianId   String
  content        String
  recommendation String?
  // Sprint 8.4 — Gouvernance du diagnostic : mode explicite d'origine du
  // diagnostic (CATALOG = catalogue RepairDom, MANUAL = non référencé).
  mode DiagnosticMode @default(MANUAL)
  // Sprint 8.4 — diagnostic non référencé : intervention proposée, justification
  // du diagnostic et note fréquemment libre. NULL pour les diagnostics catalogue.
  proposedIntervention String?
  justification        String?
  notes                String?
  // Lien optionnel vers le catalogue (Sprint 8.1) : diagnostic sélectionné
  // par le technicien + intervention correspondante. NULL = anomalie libre.
  catalogDiagnosticId   String?
  catalogInterventionId String?
  createdAt      DateTime @default(now())

  demande    Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  catalogDiagnostic   CatalogDiagnostic?   @relation(fields: [catalogDiagnosticId], references: [id], onDelete: SetNull)
  catalogIntervention CatalogIntervention? @relation(fields: [catalogInterventionId], references: [id], onDelete: SetNull)
  quotes      Quote[]

  @@index([demandeId])
  @@index([catalogDiagnosticId])
  @@index([catalogInterventionId])
}

model Quote {
  id           String      @id @default(dbgenerated("gen_random_uuid()"))
  demandeId    String
  technicianId String
  amount       Int
  currency     String      @default("XAF")
  description  String
  status       QuoteStatus @default(PENDING)
  // Origine du prix (Sprint 8.1).
  // MANUAL : saisi par le technicien (fallback contrôlé) — comportement historique.
  // CATALOG : généré automatiquement par RepairDom depuis le Pricing catalogue
  // (snapshot figé, indépendant des modifications ultérieures du catalogue).
  source                QuoteSource @default(MANUAL)
  // Sprint 8.6 : lien au diagnostic de mission qui motive ce tarif. Permet de
  // relier chaque proposition (CATALOG ou MANUAL) à son diagnostic (mode,
  // intervention proposée, justification, notes). NULL pour les propositions
  // créées avant le Sprint 8.6 (aucun diagnostic n'existait encore).
  diagnosticId          String?
  catalogDiagnosticId   String?
  catalogInterventionId String?
  initialReferencePrice Int?
  initialTravelFee      Int?
  initialServiceFee     Int?
  createdAt    DateTime    @default(now())

  demande    Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  diagnostic Diagnostic?       @relation(fields: [diagnosticId], references: [id], onDelete: SetNull)
  catalogDiagnostic   CatalogDiagnostic?   @relation(fields: [catalogDiagnosticId], references: [id], onDelete: SetNull)
  catalogIntervention CatalogIntervention? @relation(fields: [catalogInterventionId], references: [id], onDelete: SetNull)

  @@index([demandeId])
  @@index([diagnosticId])
  @@index([catalogDiagnosticId])
  @@index([catalogInterventionId])
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId String
  authorId  String
  targetId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target  User    @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([demandeId, authorId])
  @@index([targetId])
}

/* ── Catalogue RepairDom ────────────────────────────────────────── */

model ServiceDomain {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  slug        String   @unique
  description String?
  icon        String?
  // Catégorie métier « historique » facultative (electricite, plomberie, …) :
  // utilisée pour dériver la catégorie de matching d'une demande issue du
  // catalogue (Sprint 8.1) sans casser le matching existant.
  category    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems Problem[]
  brands   DeviceBrand[]
  demandes Demande[]

  @@index([isActive])
}

model DeviceBrand {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  domainId    String
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain  ServiceDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  models  DeviceModel[]
  problems Problem[]
  demandes Demande[]

  @@unique([domainId, slug])
  @@index([domainId])
  @@index([isActive])
}

model DeviceModel {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  brandId     String
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    DeviceBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  problems Problem[]
  demandes Demande[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([isActive])
}

model Problem {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  domainId    String
  // Ancrage marque/modèle optionnel (Sprint 8.1) :
  //   - NULL/NULL   → problème générique du domaine ;
  //   - brandId set → problème spécifique à une marque ;
  //   - brandId+modelId set → problème spécifique à un modèle.
  brandId     String?
  modelId     String?
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain      ServiceDomain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  brand       DeviceBrand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  model       DeviceModel?      @relation(fields: [modelId], references: [id], onDelete: SetNull)
  diagnostics CatalogDiagnostic[]
  demandes    Demande[]

  // L'unicité effective du slug est scopée par (domainId, brandId, modelId) :
  // garantie par un INDEX UNIQUE FONCTIONNEL créé manuellement en migration
  // (Prisma n'exprime pas les index fonctionnels) :
  //   UNIQUE (domainId, COALESCE(brandId,''), COALESCE(modelId,''), slug)
  // La même contrainte est vérifiée au niveau applicatif dans
  // catalog.service.ts (createProblem / updateProblem).
  @@index([domainId])
  @@index([domainId, slug])
  @@index([brandId])
  @@index([modelId])
  @@index([isActive])
}

model CatalogDiagnostic {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  problemId      String
  name           String
  slug           String
  description    String?
  confidence     String?
  difficulty     String?
  estimatedTime  String?
  internalNotes  String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  problem       Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  interventions CatalogIntervention[]
  missionDiagnostics Diagnostic[]
  quotes         Quote[]

  @@unique([problemId, slug])
  @@index([problemId])
  @@index([isActive])
}

model CatalogIntervention {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  diagnosticId    String
  name            String
  slug            String
  description     String?
  difficulty      String?
  estimatedTime   String?
  needsParts      Boolean  @default(false)
  partsNote       String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  diagnostic CatalogDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
pricing Pricing?
missionDiagnostics Diagnostic[]
quotes         Quote[]

  @@unique([diagnosticId, slug])
  @@index([diagnosticId])
  @@index([isActive])
}

model Pricing {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  interventionId  String
  minPrice        Int?
  referencePrice  Int?
  maxPrice        Int?
  travelFee       Int?
  serviceFee      Int?
  currency        String   @default("XAF")
  priceMode       String   @default("fixed")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  intervention CatalogIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  history      PricingHistory[]

  @@unique([interventionId])
  @@index([interventionId])
}

model PricingHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  pricingId       String
  adminId         String
  previousValues  Json
  newValues       Json
  reason          String?
  createdAt       DateTime @default(now())

  pricing Pricing   @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  user    User      @relation("PricingHistoryAuthor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([pricingId])
  @@index([adminId])
}