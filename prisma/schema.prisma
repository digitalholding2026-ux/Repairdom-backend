// Contestation / litige post-intervention (un par mission : `demandeId`
// unique = protection anti double-ouverture au niveau base, en plus des
// gardes applicatives). Ouvert uniquement par le client propriétaire sur
// une mission COMPLETED avec technicien assigné. Règlé uniquement par
// l'administration (jamais auto-clôturé, jamais de règlement par délai).
model DemandeDispute {
  id          String          @id @default(dbgenerated("gen_random_uuid()"))
  demandeId   String          @unique
  openedById  String
  category    DisputeCategory
  description String
  status      DisputeStatus   @default(OPEN)
  // Décision administrative (exigée pour RESOLVED/REJECTED).
  resolution  String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  demande  Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  openedBy User    @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)
  decider  User?   @relation("DisputeDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

