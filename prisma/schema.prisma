// Sprint 8.7-FIN — Ledger financier immuable (source de vérité financière).
//
// Règles d'intégrité (appliquées par le moteur financier, voir src/financial) :
//  - Aucune écriture utilisateur n'est possible via l'API (aucune route de
//    création/modification/suppression de transaction exposée au frontend).
//  - Seul le serveur crée des écritures, atomiquement avec la transition
//    métier qui les motive (acceptation d'un quote, confirmation, annulation).
//  - `reference` est UNIQUE : clé d'idempotence serveur (un seul débit/crédit
//    par événement métier, résistant au double clic / retry / double appel).
//  - Le `mode` (SIMULATION/REAL) est décidé côté serveur via FINANCIAL_MODE ;
//    jamais par le frontend. Les références intègrent le mode.
//  - `reversalOfId` lie une écriture REVERSAL à l'écriture initiale qu'elle
//    annule. Les écritures originales ne sont JAMAIS modifiées ni supprimées.
//  - Le solde n'est jamais stocké : il se calcule par somme des montants
//    (CREDIT − DEBIT) des écritures VALIDATED d'un mode donné.
model FinancialTransaction {
  id            String                        @id @default(dbgenerated("gen_random_uuid()"))
  userId        String
  demandeId     String?
  type          FinancialTransactionType
  direction     FinancialTransactionDirection
  amount        Int
  status        FinancialTransactionStatus @default(VALIDATED)
  mode          FinancialTransactionMode   @default(SIMULATION)
  reference     String                        @unique
  reversalOfId  String?
  metadata      Json?
  createdById   String?
  createdAt     DateTime                      @default(now())

  user        User                   @relation("FinancialTransactionOwner", fields: [userId], references: [id], onDelete: Restrict)
  demande     Demande?               @relation(fields: [demandeId], references: [id], onDelete: SetNull)
  reversalOf  FinancialTransaction?  @relation("FinancialTransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals   FinancialTransaction[] @relation("FinancialTransactionReversal")
  createdBy   User?                  @relation("FinancialTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // Sprint SASPAY-01 : intentions de recharge créditées par cette écriture
  // CLIENT_TOPUP (lien traçabilité, SetNull : l'historique ledger survit).
  topupIntentsCredited TopupIntent[] @relation("TopupIntentCredit")

  @@index([userId, createdAt])
  @@index([demandeId, createdAt])
  @@index([mode, userId])
}

// Sprint ADMIN SUPER POWERS — Retraits des fonds Relio.
//
// Une ligne = un retrait effectué par un admin sur les commissions Relio
// acquises (2 % du brut, créditées via TECHNICIAN_FEE — + CLIENT_FEE legacy).
// Traçabilité : `reference` UNIQUE (RELIO-WD-…) = clé d'idempotence serveur ;
// chaque retrait est doublé d'une écriture ledger RELIO_WITHDRAWAL immuable
// (lien via metadata.withdrawalId), jamais modifiée ni supprimée.
// Solde disponible Relio = Σ commissions VALIDATED − Σ retraits VALIDATED
// (calculé par le moteur financier, jamais stocké).
// ON DELETE RESTRICT sur requestedById : un admin ayant effectué un retrait
// ne peut pas être supprimé physiquement (audit préservé).
//
// Sprint SASPAY-01 (fondations) — préparation payout asynchrone :
// `payoutStatus` distingue DEMANDÉ (PENDING) / RÉUSSI (SUCCESS) / ÉCHOUÉ
// (FAILED) / ANNULÉ (CANCELLED). Seuls les retraits SUCCESS réduisent le
// disponible Relio. Les lignes historiques (créées synchrones avant ce
// sprint) portent payoutStatus = SUCCESS. Les références SasPay et
// `idempotencyKey` (UNIQUE) permettent la réconciliation et l'idempotence
// webhook. `status` (FinancialTransactionStatus) est conservé inchangé pour
// ne casser aucune lecture existante.
model RelioWithdrawal {
  id          String                        @id @default(dbgenerated("gen_random_uuid()"))
  reference   String                        @unique
  amount      Int
  note        String?
  mode        FinancialTransactionMode      @default(SIMULATION)
  status      FinancialTransactionStatus    @default(VALIDATED)
  payoutStatus SasPayOperationStatus        @default(SUCCESS)
  saspayTransactionId String?
  saspayReference     String?
  externalReference   String?
  idempotencyKey      String?               @unique
  errorMessage        String?
  requestedById String
  requestedBy User                          @relation("RelioWithdrawalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([mode, createdAt])
  @@index([payoutStatus])
  @@index([saspayTransactionId])
}

// Sprint SASPAY-01 (fondations) — Intention de recharge client.
//
// Cette table n'est PAS un deuxième ledger : elle ne porte aucun solde et
// ne crédite rien par elle-même. Elle suit une intention de paiement AVANT
// crédit du ledger (montant demandé, statuts, références SasPay,
// idempotency key, montants de réconciliation).
// Le ledger (FinancialTransaction CLIENT_TOPUP CREDIT) n'est alimenté que
// par `confirmTopupIntent()` après confirmation serveur fiable (webhook
// SasPay transaction.success), de façon idempotente et transactionnelle.
// Règle SasPay : ne jamais utiliser le seul `requested amount` comme vérité
// comptable — `fee`, `chargedAmount` et `netAmount` sont conservés dès que
// le prestataire les communique.
// ON DELETE RESTRICT sur userId : l'historique des intentions est préservé.
model TopupIntent {
  id            String                  @id @default(dbgenerated("gen_random_uuid()"))
  // Référence interne Relio UNIQUE (TOPUP-…) : idempotence niveau Relio.
  reference     String                  @unique
  // Clé d'idempotence UNIQUE (fournie par l'appelant ou générée) : une même
  // demande rejouée retourne l'intention existante, sans doublon.
  idempotencyKey String                 @unique
  userId        String
  user          User                    @relation("TopupIntentOwner", fields: [userId], references: [id], onDelete: Restrict)
  amount        Int
  currency      String                  @default("XAF")
  mode          FinancialTransactionMode @default(SIMULATION)
  status        SasPayOperationStatus   @default(PENDING)
  // Références prestataire (idempotence niveau SasPay + réconciliation).
  saspayTransactionId String?
  saspayReference     String?
  externalReference   String?
  network             String?
  country             String?
  // Montants de réconciliation (le `netAmount` constaté fait foi, jamais le
  // seul montant demandé).
  requestedAmount Int?
  fee             Int?
  chargedAmount   Int?
  netAmount       Int?
  // Écriture ledger créée au SUCCESS (NULL tant que PENDING/FAILED).
  creditedTransactionId String?
  creditedTransaction FinancialTransaction? @relation("TopupIntentCredit", fields: [creditedTransactionId], references: [id], onDelete: SetNull)
  errorMessage  String?
  metadata      Json?
  createdById   String?
  createdBy     User?                   @relation("TopupIntentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([saspayTransactionId])
}

// Sprint SASPAY-01 (fondations) — Demande de retrait client/technicien.
//
// Cycle : AVAILABLE → hold ACTIVE + demande PENDING → payout SasPay →
// SUCCESS (débit ledger définitif CLIENT_WITHDRAWAL/TECHNICIAN_WITHDRAWAL +
// hold CONSUMED) ou FAILED/CANCELLED (hold RELEASED, fonds libérés, aucune
// écriture ledger). Un payout PENDING n'est jamais un SUCCESS.
// Le débit ledger n'existe qu'au SUCCESS ; l'idempotence repose sur
// `reference` + `idempotencyKey` UNIQUE + référence ledger déterministe.
// ON DELETE RESTRICT sur userId : audit préservé.
model WithdrawalRequest {
  id            String                  @id @default(dbgenerated("gen_random_uuid()"))
  reference     String                  @unique
  idempotencyKey String                 @unique
  userId        String
  user          User                    @relation("WithdrawalRequestOwner", fields: [userId], references: [id], onDelete: Restrict)
  amount        Int
  currency      String                  @default("XAF")
  mode          FinancialTransactionMode @default(SIMULATION)
  status        SasPayOperationStatus   @default(PENDING)
  // Verrou logique adossé (fonds gelés tant que PENDING).
  holdId        String?
  hold          FundsHold?              @relation("WithdrawalRequestHold", fields: [holdId], references: [id], onDelete: SetNull)
  // Référence de l'écriture ledger créée au SUCCESS (NULL avant).
  ledgerReference String?
  saspayTransactionId String?
  saspayReference     String?
  externalReference   String?
  network             String?
  country             String?
  requestedAmount Int?
  fee             Int?
  chargedAmount   Int?
  netAmount       Int?
  errorMessage  String?
  metadata      Json?
  createdById   String?
  createdBy     User?                   @relation("WithdrawalRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([saspayTransactionId])
}

// Sprint SASPAY-01 (fondations) — Réservation de fonds (verrou logique).
//
// Un hold gele un montant du disponible SANS créer de solde stocké :
// disponible = Σ ledger VALIDATED − Σ holds ACTIVE (calculé, jamais stocké).
// Usage : mission (demandeId) ou retrait (via WithdrawalRequest.holdId).
// Référence UNIQUE idempotente (`hold:…` ou HOLD-… générée). Les holds ne
// sont jamais modifiés en montant : ACTIVE → RELEASED (libéré) ou CONSUMED
// (opération définitive). Toute lecture + réservation concurrente passe
// sous verrou consultatif PostgreSQL (voir FinancialService).
// ON DELETE RESTRICT sur userId ; SET NULL vers Demande (historique survit).
model FundsHold {
  id            String                  @id @default(dbgenerated("gen_random_uuid()"))
  reference     String                  @unique
  userId        String
  user          User                    @relation("FundsHoldOwner", fields: [userId], references: [id], onDelete: Restrict)
  demandeId     String?
  demande       Demande?                @relation(fields: [demandeId], references: [id], onDelete: SetNull)
  amount        Int
  currency      String                  @default("XAF")
  mode          FinancialTransactionMode @default(SIMULATION)
  status        FundsHoldStatus         @default(ACTIVE)
  metadata      Json?
  createdById   String?
  createdBy     User?                   @relation("FundsHoldCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now())
  releasedAt    DateTime?
  withdrawals WithdrawalRequest[]       @relation("WithdrawalRequestHold")

  @@index([userId, status])
  @@index([demandeId])
  @@index([mode, status])
}