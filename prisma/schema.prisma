generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  TECHNICIAN
}

enum DemandeStatus {
  SUBMITTED
  PENDING
  ACCEPTED
  CANCELED
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

model User {
  id                  String              @id @default(dbgenerated("gen_random_uuid()"))
  role                Role                @default(CLIENT)
  firstName           String
  lastName            String?
  phone               String?
  email               String              @unique
  passwordHash        String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  demandes            Demande[]           @relation("ClientDemandes")
  technicianDemandes  Demande[]           @relation("TechnicianDemandes")
  technicianProfile   TechnicianProfile?
}

model Demande {
  id          String        @id @default(dbgenerated("gen_random_uuid()"))
  reference   String        @unique
  status      DemandeStatus @default(SUBMITTED)
  category    String
  description String
  city        String
  address     String?
  client      User          @relation("ClientDemandes", fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  technician  User?         @relation("TechnicianDemandes", fields: [technicianId], references: [id], onDelete: SetNull)
  technicianId String?
  medias      DemandeMedia[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([technicianId])
  @@index([status])
}

model TechnicianProfile {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city       String
  categories String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DemandeMedia {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  kind      MediaKind
  fileName  String
  mimeType  String
  sizeBytes Int
  stored    Boolean   @default(false)
  url       String?
  demande   Demande   @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  demandeId String
  createdAt DateTime  @default(now())

  @@index([demandeId])
}