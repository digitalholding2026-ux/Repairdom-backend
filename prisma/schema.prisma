generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  TECHNICIAN
  ADMIN
}

enum DemandeStatus {
  SUBMITTED
  PENDING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  CANCELED
}

// Sprint 8.3 : journal métier des missions.
enum DemandeEventType {
  CREATED
  TECHNICIAN_ASSIGNED
  TECHNICIAN_ACCEPTED
  DIAGNOSTIC_SELECTED
  // Sprint 8.4 : trace dédiée du diagnostic non référencé (déclaré librement),
  // distincte du DIAGNOSTIC_SELECTED du catalogue.
  MANUAL_DIAGNOSTIC_DECLARED
  QUOTE_CREATED
  NEGOTIATION_REQUESTED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  CANCELED
  // Sprint DISPATCH-V1 : vague de dispatch notifiée (metadata : wave, candidateCount).
  DISPATCH_WAVE
  // GPS V3 : déplacement temporaire lié à la mission (aucun changement de
  // statut métier, journal informatif uniquement).
  TECHNICIAN_EN_ROUTE
  TECHNICIAN_ARRIVED
}

// Sprint 8.3 : notifications applicatives (créées uniquement par le backend).
// Sprint DISPATCH-V1 : MISSION_AVAILABLE = nouvelle mission proposée aux
// techniciens (antérieure à toute acceptation, distincte des types post-assignation).
// Sprint ADMIN SUPER POWERS : ADMIN_MESSAGE = message direct de l'admin à un
// technicien (identifié par son email), sans mission liée.
enum NotificationType {
  TECHNICIAN_ACCEPTED
  QUOTE_CREATED
  NEGOTIATION_REQUESTED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  SCHEDULED
  COMPLETED
  CONFIRMED
  MISSION_AVAILABLE
  ADMIN_MESSAGE
  // GPS V3 : le technicien assigné a démarré son déplacement (notifié au
  // client de la mission uniquement).
  TECHNICIAN_EN_ROUTE
  // IA-7 : écart au barème (ABOVE_MAX) — avertissement factuel au
  // technicien, justification 48 h, jamais une sanction.
  PRICING_WARNING
  // IA-8 : signal de surveillance conversationnelle — notifié aux ADMIN
  // uniquement (jamais au client/technicien, jamais dans le chat).
  CONVERSATION_FLAG
}

// Sprint 8.4 — Gouvernance du diagnostic : origine d'un diagnostic de mission.
// CATALOG : diagnostic sélectionné dans le catalogue RepairDom (pricing auto).
// MANUAL : « diagnostic non référencé », déclaré librement par le technicien
// (intervention proposée + justification + note libre) avec tarif manuel.
enum DiagnosticMode {
  CATALOG
  MANUAL
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

enum RequestTiming {
  ASAP
  SCHEDULED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Sprint 8.6 — Origine d'un tarif.
// CATALOG : tarif automatique RepairDom, généré depuis le Pricing catalogue
//           (snapshot figé, indépendant des modifications ultérieures).
// MANUAL  : tarif manuel, exclusivement lié à un « diagnostic non référencé ».
enum QuoteSource {
  CATALOG
  MANUAL
}

// Sprint 8.7-FIN — Ledger financier de simulation (source de vérité financière).
// Le montant d'une écriture est toujours à interpréter avec sa `direction` :
//   solde = Σ(CREDIT) − Σ(DEBIT) sur les écritures VALIDATED d'un mode donné.
// Un ledger est IMMUABLE : aucune modification/suppression via l'API. Toute
// correction passe par une écriture REVERSAL liée via `reversalOfId`.
enum FinancialTransactionType {
  INITIAL_TEST_CREDIT
  CLIENT_MISSION_DEBIT
  CLIENT_FEE
  TECHNICIAN_REPAIR_REVENUE
  TECHNICIAN_TRAVEL_REVENUE
  TECHNICIAN_FEE
  REVERSAL
  // Sprint ADMIN SUPER POWERS : retrait des fonds Relio par l'admin (débit,
  // lié à la ligne RelioWithdrawal correspondante via metadata.withdrawalId).
  RELIO_WITHDRAWAL
  // Sprint SASPAY-01 (fondations) : nouveaux types du ledger UNIQUE.
  // CLIENT_TOPUP (CREDIT) = vraie recharge client confirmée côté serveur
  // (webhook SasPay), distincte du crédit de test INITIAL_TEST_CREDIT
  // (simulation, ADMIN uniquement). Le ledger n'est crédité qu'après
  // confirmation fiable du prestataire, jamais sur indication du frontend.
  CLIENT_TOPUP
  // Débits définitifs de retraits async (créés uniquement au SUCCESS du
  // payout, après consommation du hold — voir FundsHold/WithdrawalRequest).
  CLIENT_WITHDRAWAL
  TECHNICIAN_WITHDRAWAL
}

enum FinancialTransactionDirection {
  CREDIT
  DEBIT
}

enum FinancialTransactionStatus {
  VALIDATED
  REVERSED
}

enum FinancialTransactionMode {
  SIMULATION
  REAL
}

// Sprint SASPAY-01 (fondations) — Statut d'une opération SasPay asynchrone
// (intention de recharge, demande de retrait). PENDING n'est JAMAIS une
// preuve de paiement : seul SUCCESS déclenche une écriture ledger.
enum SasPayOperationStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

// Sprint SASPAY-01 (fondations) — Cycle de vie d'une réservation de fonds
// (FundsHold, verrou logique, jamais un solde stocké).
// ACTIVE = montant gelé ; RELEASED = libéré (échec/annulation) ;
// CONSUMED = consommé par l'opération définitive (débit ledger).
enum FundsHoldStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocumentType {
  IDENTITY
  PROFESSIONAL
}

model User {
  id                  String              @id @default(dbgenerated("gen_random_uuid()"))
  role                Role                @default(CLIENT)
  firstName           String
  lastName            String?
  phone               String?
  // Sprint 8.7 — `city` texte libre conservé (affichage/transition) ;
  // `cityId` référence structurée nullable pendant la transition.
  city                String?
  cityId              String?
  cityRef             ServiceCity? @relation("CityClients", fields: [cityId], references: [id], onDelete: SetNull)
  address             String?
  whatsapp            String?
  avatarUrl           String?
  email               String              @unique
  emailVerified       Boolean             @default(true)
  emailVerificationToken String?
  emailVerificationExpiresAt DateTime?
  passwordHash        String
  // Sprint ADMIN SUPER POWERS — désactivation logique d'un compte par
  // l'admin (alternative à la suppression physique quand l'historique
  // métier/financier doit être conservé). Un compte désactivé ne peut plus
  // se connecter ; ses missions, devis et écritures restent lisibles.
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  demandes            Demande[]           @relation("ClientDemandes")
  technicianDemandes  Demande[]           @relation("TechnicianDemandes")
  technicianProfile   TechnicianProfile?
  kycDocuments        KycDocument[]
  kycReviewsMade      KycReview[]      @relation("KycReviewReviewer")
  kycReviews          KycReview[]      @relation("KycReviewTechnician")
  messages            Message[]
  diagnostics         Diagnostic[]
  quotes              Quote[]
  // IA-7 — avertissements reçus (technicien) et revues effectuées (admin).
  aiWarnings          AiWarning[] @relation("AiWarningTechnician")
  aiWarningReviews    AiWarning[] @relation("AiWarningReviewer")
  // IA-8 — messages envoyés pouvant porter un signal + revues effectuées.
  conversationFlagsSent     AiConversationFlag[] @relation("ConversationFlagSender")
  conversationFlagReviews   AiConversationFlag[] @relation("ConversationFlagReviewer")
  reviewsAuthored     Review[]     @relation("ReviewAuthor")
  reviewsReceived     Review[]     @relation("ReviewTarget")
  pricingHistories    PricingHistory[] @relation("PricingHistoryAuthor")
  demandeEvents       DemandeEvent[]
  notifications       Notification[]
  dispatchWaves       DispatchWave[]
  financialTransactions FinancialTransaction[] @relation("FinancialTransactionOwner")
  financialTransactionsCreated FinancialTransaction[] @relation("FinancialTransactionCreator")
  relioWithdrawals RelioWithdrawal[] @relation("RelioWithdrawalRequester")
  // Sprint SASPAY-01 (fondations) : intentions de recharge, demandes de
  // retrait et réservations de fonds (verrous logiques, jamais un solde).
  topupIntents TopupIntent[] @relation("TopupIntentOwner")
  topupIntentsCreated TopupIntent[] @relation("TopupIntentCreator")
  withdrawalRequests WithdrawalRequest[] @relation("WithdrawalRequestOwner")
  withdrawalRequestsCreated WithdrawalRequest[] @relation("WithdrawalRequestCreator")
  fundsHolds FundsHold[] @relation("FundsHoldOwner")
  fundsHoldsCreated FundsHold[] @relation("FundsHoldCreator")
}

// Sprint UX CLIENT — zones de service (villes) couvertes par RepairDom.
// Catalogue administrable : les villes NE sont PAS codées en dur côté
// frontend ; l'API publique expose uniquement les zones actives.
model ServiceCity {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sprint 8.7 — références structurées vers les entités qui utilisent la ville.
  // ON DELETE SET NULL : la suppression d'une ville casse la FK mais JAMAIS les
  // chaînes textuelles historiques (User.city / Demande.city restent intactes).
  zones       Zone[]               @relation("CityZones")
  clients     User[]               @relation("CityClients")
  technicians TechnicianProfile[]  @relation("CityTechnicians")
  demandes    Demande[]            @relation("CityDemandes")
}

// Sprint 8.7 — Zones (quartiers/secteurs) rattachées à une ServiceCity.
// Référentiel administrable via l'API admin ; alimenté progressivement (aucun
// quartier n'est inventé par le système). Le slug est unique au sein de la
// ville pour éviter les collisions entre villes différentes.
model Zone {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  cityId    String
  name      String
  slug      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city     ServiceCity @relation("CityZones", fields: [cityId], references: [id], onDelete: Cascade)
  coverages TechnicianZoneCoverage[]
  // Sprint 8.8.2 — rattachement structuré optionnel des demandes à une zone.
  // Nullable + SetNull : les demandes historiques restent lisibles avec
  // `zoneId = null`, aucun backfill depuis `neighborhood` (texte conservé).
  demandes  Demande[]              @relation("ZoneDemandes")

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([isActive])
}

// Sprint 8.7 — Couverture géographique d'un technicien (N ↔ N).
// Un technicien couvre plusieurs zones ; une zone peut être couverte par
// plusieurs techniciens. Table de jointure explicite : le matching
// géographique s'appuiera dessus dans un sprint dédié (celui-ci ne fait que
// poser la structure, sans toucher au matching textuel existant).
model TechnicianZoneCoverage {
  id                  String   @id @default(dbgenerated("gen_random_uuid()"))
  technicianProfileId String
  zoneId              String
  createdAt           DateTime @default(now())

  technicianProfile TechnicianProfile @relation(fields: [technicianProfileId], references: [id], onDelete: Cascade)
  zone              Zone               @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([technicianProfileId, zoneId])
  @@index([zoneId])
}

model Demande {
  id          String        @id @default(dbgenerated("gen_random_uuid()"))
  reference   String        @unique
  status      DemandeStatus @default(SUBMITTED)
  category    String
  // Dépôt multimédia — description textuelle OPTIONNELLE depuis le dépôt
  // multimédia (vocal/vidéo/photos). Nullable : les demandes historiques
  // gardent leur texte ; les nouvelles demandes multimédia ont NULL (le
  // technicien lit les pièces jointes). Colonne conservée (compatibilité).
  description String?
  // IA-4.1 — équipement déclaré par le client en texte libre (« réfrigérateur »,
  // « portail électrique »…), obligatoire quand `category` vaut `autre`
  // (validation backend). Identifie L'OBJET à réparer, pas la panne (les
  // médias expliquent la panne). Nullable : demandes historiques et domaines
  // catalogue connus. Signal principal d'IA-4, affiché au technicien comme
  // information client (jamais un diagnostic).
  equipmentType String?
  // Sprint 8.7 — `city` reste le snapshot texte historique de la mission
  // (JAMAIS supprimé ni rendu optionnel) ; `cityId` est une référence
  // optionnelle vers ServiceCity. Un ON DELETE SET NULL garantit qu'une ville
  // supprimée/modifiée du référentiel ne casse jamais l'historique.
  city        String
  cityId      String?
  cityRef     ServiceCity?     @relation("CityDemandes", fields: [cityId], references: [id], onDelete: SetNull)
  // Sprint 8.8.2 — `zoneId` référence optionnelle vers Zone (quartier/secteur
  // structuré). Nullable pendant la transition : les demandes créées sans zone
  // ou avant ce sprint ont `zoneId = null` et suivent le parcours historique.
  // ON DELETE SET NULL : la suppression d'une zone ne casse jamais l'historique
  // (`city` / `neighborhood` textes restant intacts).
  zoneId      String?
  zoneRef     Zone?            @relation("ZoneDemandes", fields: [zoneId], references: [id], onDelete: SetNull)
  neighborhood String?
  address     String?
  landmark    String?
  contactPhone String?
  // GPS V1 — position de la demande (nullable : demandes historiques sans
  // GPS). Complète city/cityId/zone/adresse (jamais remplacés). Bornes
  // validées côté API (-90..90 / -180..180).
  latitude    Float?
  longitude   Float?
  // GPS V3 — localisation TEMPORAIRE de déplacement liée à la mission
  // (« technicien en route ») : position transmise explicitement par le
  // technicien assigné lors de l'action « Je suis en route » (puis
  // actualisations volontaires et « Je suis arrivé »). Chaque transmission
  // écrase la précédente : pas d'historique, pas de tracking, pas de
  // WebSocket. Tous les champs sont NULLABLES et non destructifs ;
  // `technicianArrivedAt` renseigné = déplacement clos (position de
  // déplacement plus exposée comme active).
  travelLatitude          Float?
  travelLongitude         Float?
  travelLocationUpdatedAt DateTime?
  technicianEnRouteAt     DateTime?
  technicianArrivedAt     DateTime?
  client      User          @relation("ClientDemandes", fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  technician  User?         @relation("TechnicianDemandes", fields: [technicianId], references: [id], onDelete: SetNull)
  technicianId String?
  scheduledAt DateTime?
  requestedMode RequestTiming @default(ASAP)
  requestedAt   DateTime?
  // Contexte matériel issu du catalogue (Sprint 8.1) — optionnel pour rester
  // compatible avec les demandes créées avant l'arrivée du catalogue.
  domain ServiceDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  domainId String?
  brand   DeviceBrand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId String?
  model   DeviceModel?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
  modelId String?
  problem Problem?       @relation(fields: [problemId], references: [id], onDelete: SetNull)
  problemId String?
  // Négociation (Sprint 8.1) : le chat de négociation n'est ouvert qu'après
  // la demande explicite du client (negotiationRequestedAt).
  negotiationRequestedAt DateTime?
  // Traçabilité : montant final accepté (quote ACCEPTED) de la mission.
  finalAmount Int?
  medias      DemandeMedia[]
  // IA-7 — avertissements tarifaires de la mission (consultation admin).
  aiWarnings  AiWarning[]
  // IA-8 — signaux de surveillance conversationnelle (consultation admin).
  conversationFlags AiConversationFlag[]
  // IA-4 — classification « Autre » (proposition IA auditable, donnée
  // client jamais écrasée). Optionnelle : la plupart des demandes
  // (domaine connu) n'en ont pas.
  classification DemandeClassification?
  messages    Message[]
  diagnostics Diagnostic[]
  quotes      Quote[]
  reviews     Review[]
  events      DemandeEvent[]
  notifications Notification[]
  dispatchWaves DispatchWave[]
  financialTransactions FinancialTransaction[]
  fundsHolds FundsHold[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([technicianId])
  @@index([status])
  @@index([zoneId])
  @@index([domainId])
  @@index([brandId])
  @@index([modelId])
  @@index([problemId])
}

model DemandeEvent {
  id          String          @id @default(dbgenerated("gen_random_uuid()"))
  demandeId   String
  actorUserId String?
  type        DemandeEventType
  fromStatus  DemandeStatus?
  toStatus    DemandeStatus?
  metadata    Json?
  createdAt   DateTime        @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([demandeId, createdAt])
  @@index([actorUserId])
}

model Notification {
  id        String          @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  demandeId String?
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime        @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  demande Demande? @relation(fields: [demandeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Sprint DISPATCH-V1 — suivi des vagues de dispatch (dispatch intelligent).
//
// Une ligne = un technicien contacté pour une demande, une vague, un canal.
// Source de vérité anti-doublon : @@unique([demandeId, wave, userId, channel])
// (idempotence face aux redémarrages, doubles exécutions scheduler et
// relances accidentelles).
// ON DELETE CASCADE des deux côtés : la suppression d'une demande ou d'un
// compte efface ses traces de dispatch, sans jamais bloquer (aucun Restrict).
// `channel` reste un texte ('IN_APP' / 'EMAIL') : WhatsApp/SMS hors périmètre
// V1, aucun nouveau type tant qu'ils ne sont pas décidés.
// `sentAt` = heure d'envoi effective (référence des +10 minutes vers vague 2).
model DispatchWave {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId String
  userId    String
  wave      Int
  channel   String
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([demandeId, wave, userId, channel])
  @@index([demandeId, wave])
  @@index([wave, sentAt])
}

model TechnicianProfile {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Sprint 8.7 — `city` texte libre conservé (donnée existante/affichable) ;
  // `cityId` référence structurée nullable. `zoneCoverages` = couverture N↔N.
  city       String
  cityId     String?
  cityRef    ServiceCity? @relation("CityTechnicians", fields: [cityId], references: [id], onDelete: SetNull)
  categories String[]
  isAvailable Boolean @default(false)
  avatarUrl  String?
  bio        String?
  experience String?
  serviceDescription String?
  specialties String[] @default([])
  kycStatus  KycStatus @default(NOT_SUBMITTED)
  kycRejectionReason String?
  // GPS V1 — dernière position connue transmise explicitement par le
  // technicien (pas d'historique, pas de tracking). Nullable : aucune
  // position tant que le technicien ne l'a jamais envoyée.
  // `locationUpdatedAt` = horodatage de la dernière transmission (distinct
  // de `updatedAt` qui suit toute modification du profil).
  lastLatitude     Float?
  lastLongitude    Float?
  locationUpdatedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  zoneCoverages TechnicianZoneCoverage[]
}

model KycDocument {
  id           String          @id @default(dbgenerated("gen_random_uuid()"))
  technicianId String
  type         KycDocumentType
  storagePath  String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime        @default(now())

  technician   User            @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId])
}

model KycReview {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  technicianId   String
  reviewerId     String
  previousStatus KycStatus
  newStatus      KycStatus
  reason         String?
  createdAt      DateTime  @default(now())

  technician User @relation("KycReviewTechnician", fields: [technicianId], references: [id], onDelete: Cascade)
  reviewer   User @relation("KycReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([technicianId])
  @@index([reviewerId])
}

model DemandeMedia {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  kind      MediaKind
  fileName  String
  mimeType  String
  sizeBytes Int
  stored    Boolean   @default(false)
  url       String?
  // Dépôt multimédia — chemin d'objet dans le bucket privé
  // `relio-demande-medias` (`demandes/{userId}/{uuid}-...`). Renseigné dès
  // l'upload (avant création de la Demande) puis lié en transaction à la
  // création : le technicien assigné y accède immédiatement via des URLs
  // signées éphémères (jamais d'URL publique persistée).
  storagePath String?
  demande   Demande   @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  demandeId String
  createdAt DateTime  @default(now())

  @@index([demandeId])
}

// IA-4 — classification d'une demande « Autre » (aide au dispatch).
// Sépare strictement la DONNÉE CLIENT (Demande.category, jamais écrasée)
// de la PROPOSITION IA (cette table, auditable). Une ligne par demande
// (idempotence : rejouée sans doublon), y compris en fallback (raison
// tracée). Lue par le dispatch comme signal d'enrichissement uniquement.
model DemandeClassification {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId      String   @unique
  // Domaine proposé (doit exister et être actif, vérifié à l'écriture).
  domainId       String?
  // Catégories proposées (toutes dans ALLOWED_CATEGORIES, vérifié).
  categories     String[] @default([])
  confidence     Float?
  // CLASSIFIED | UNCERTAIN | UNCLASSIFIABLE (jamais d'autre valeur).
  classification String
  model          String?
  promptVersion  Int      @default(1)
  // Motif technique borné (AI_DISABLED, TIMEOUT, INVALID_RESPONSE,
  // LOW_CONFIDENCE, UNKNOWN_DOMAIN, OK) — jamais de contenu client.
  reason         String?
  createdAt      DateTime @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  @@index([domainId])
}

model Message {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  // IA-8 — signaux de surveillance (un par message, jamais une mutation).
  conversationFlags AiConversationFlag[]

  @@index([demandeId])
  @@index([senderId])
}

model Diagnostic {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId      String
  technicianId   String
  content        String
  recommendation String?
  // Sprint 8.4 — Gouvernance du diagnostic : mode explicite d'origine du
  // diagnostic (CATALOG = catalogue RepairDom, MANUAL = non référencé).
  mode DiagnosticMode @default(MANUAL)
  // Sprint 8.4 — diagnostic non référencé : intervention proposée, justification
  // du diagnostic et note fréquemment libre. NULL pour les diagnostics catalogue.
  proposedIntervention String?
  justification        String?
  notes                String?
  // Lien optionnel vers le catalogue (Sprint 8.1) : diagnostic sélectionné
  // par le technicien + intervention correspondante. NULL = anomalie libre.
  catalogDiagnosticId   String?
  catalogInterventionId String?
  // IA-3 — note vocale facultative du diagnostic libre : chemin d'objet
  // dans le bucket privé `relio-demande-medias` (`diagnostics/{userId}/…`),
  // uploadé AVANT création puis lié en transaction. Lecture via URLs
  // signées éphémères (jamais d'URL publique). NULL = sans audio.
  // Immuable avec le diagnostic (source conservée pour IA-5).
  audioStoragePath String?
  createdAt      DateTime @default(now())

  demande    Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  catalogDiagnostic   CatalogDiagnostic?   @relation(fields: [catalogDiagnosticId], references: [id], onDelete: SetNull)
  catalogIntervention CatalogIntervention? @relation(fields: [catalogInterventionId], references: [id], onDelete: SetNull)
  quotes      Quote[]
  // IA-5 — correspondance catalogue ANALYTIQUE du diagnostic libre
  // (jamais une réécriture : le texte/audio source reste la vérité métier,
  // `mode` reste MANUAL). Une ligne max (rejouée sans doublon).
  catalogMatch DiagnosticCatalogMatch?

  @@index([demandeId])
  @@index([catalogDiagnosticId])
  @@index([catalogInterventionId])
}

// IA-5 — correspondance IA entre un diagnostic libre technicien et un
// CatalogDiagnostic existant (analytique uniquement : ne réécrit jamais le
// diagnostic, ne change jamais `mode`, ne touche jamais au devis).
// Une ligne par diagnostic (idempotence), fallback tracé (UNCERTAIN /
// UNMATCHED + motif). Lue par IA-6/IA-9 et l'admin ; jamais par le client.
model DiagnosticCatalogMatch {
  id                  String   @id @default(dbgenerated("gen_random_uuid()"))
  diagnosticId        String   @unique
  // Diagnostic catalogue proposé (doit exister et être actif, vérifié).
  catalogDiagnosticId String?
  confidence          Float?
  // MATCHED | UNCERTAIN | UNMATCHED (jamais d'autre valeur).
  classification      String
  model               String?
  promptVersion       Int      @default(1)
  // Motif technique borné (OK, LOW_CONFIDENCE, UNKNOWN_DIAGNOSTIC,
  // INACTIVE_DIAGNOSTIC, NO_CANDIDATE, INVALID_RESPONSE, AI_DISABLED,
  // UPSTREAM, REJECTED) — jamais de contenu client.
  reason              String?
  createdAt           DateTime @default(now())

  diagnostic        Diagnostic         @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  catalogDiagnostic CatalogDiagnostic? @relation(fields: [catalogDiagnosticId], references: [id], onDelete: SetNull)

  @@index([catalogDiagnosticId])
}

// IA-6 — contrôle tarifaire déterministe d'un devis (surveillance, jamais
// de blocage). Snapshot IMMUABLE du barème applicable au moment du devis
// (min/référence/max + pricings sources) : une modification ultérieure du
// catalogue ne réécrit jamais cette ligne (création unique par devis).
// Le devis et son montant restent intacts ; seul ce signal est ajouté.
model QuotePricingCheck {
  id                  String   @id @default(dbgenerated("gen_random_uuid()"))
  quoteId             String   @unique
  demandeId           String
  diagnosticId        String?
  catalogDiagnosticId String?
  proposedPrice       Int
  minAtCheck          Int?
  referenceAtCheck    Int?
  maxAtCheck          Int?
  // NORMAL | ABOVE_MAX | BELOW_MIN | UNCERTAIN | NO_BAREME.
  result              String
  // IDs des Pricing ayant composé le barème (traçabilité version exacte).
  pricingIds          String[] @default([])
  // Écart absolu XAF (entier) et relatif en points de base (entier, null
  // sans référence > 0). Toujours null pour NORMAL/UNCERTAIN/NO_BAREME.
  deviationAmount     Int?
  deviationBps        Int?
  // Motif technique borné (OK, NO_MATCH, NO_PRICING, INACTIVE_SCALE,
  // PARTIAL_BOUNDS, UNKNOWN_QUOTE) — jamais de contenu client.
  reason              String?
  createdAt           DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([demandeId])
  @@index([result])
}

// IA-7 — avertissement tarifaire (surveillance progressive, JAMAIS une
// sanction automatique). Une ligne par contrôle ABOVE_MAX (idempotence via
// pricingCheckId unique) ; historique immuable (justification et revue
// s'ajoutent, rien n'est écrasé ni supprimé).
// Expiration LAZY : `status` stocké ∈ {PENDING, JUSTIFIED, REVIEWED} ;
// EXPIRED est dérivé (PENDING + dueAt dépassé), sans timer ni réécriture.
model AiWarning {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  technicianId    String
  demandeId       String
  quoteId         String
  diagnosticId    String?
  pricingCheckId  String   @unique
  warningType     AiWarningType @default(PRICE_ABOVE_MAX)
  status          AiWarningStatus @default(PENDING)
  // Échéance calculée backend (createdAt + 48 h), jamais d'horloge frontend.
  dueAt           DateTime
  justification   String?
  justifiedAt     DateTime?
  // Justification arrivée après l'échéance (conservée, décision à l'admin).
  isLateJustification Boolean @default(false)
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNote      String?
  createdAt       DateTime @default(now())

  technician User             @relation("AiWarningTechnician", fields: [technicianId], references: [id], onDelete: Cascade)
  demande    Demande          @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  quote      Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  reviewer   User?            @relation("AiWarningReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([technicianId, status])
  @@index([demandeId])
  @@index([status, dueAt])
}

// IA-7 — types d'avertissement (extensible, un seul aujourd'hui : un
// BELOW_MIN ou NO_BAREME ne crée JAMAIS d'avertissement).
enum AiWarningType {
  PRICE_ABOVE_MAX
}

// IA-7 — statuts STOCKÉS (EXPIRED est dérivé : PENDING + dueAt dépassé).
enum AiWarningStatus {
  PENDING
  JUSTIFIED
  REVIEWED
}

// IA-8 — signal de surveillance conversationnelle (SIGNAL uniquement :
// jamais d'écriture dans le chat, jamais de blocage, jamais de sanction —
// toute décision reste humaine, revue admin via IA-9).
// Un flag par message analysé (idempotence via messageId unique) ; le
// message original reste la source de vérité (aucune copie intégrale
// stockée ici). Historique immuable (revue/dismiss s'ajoutent, rien
// n'est supprimé). Aucun appel OpenRouter hors AiGatewayService.
model AiConversationFlag {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId       String
  messageId       String   @unique
  senderId        String
  senderRole      String
  category        AiConversationCategory
  confidence      Float
  severity        AiConversationSeverity
  // Synthèse factuelle courte du modèle (jamais une conclusion de culpabilité).
  reason          String?
  model           String?
  promptVersion   Int      @default(1)
  status          AiConversationFlagStatus @default(OPEN)
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNote      String?
  createdAt       DateTime @default(now())

  demande  Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sender   User    @relation("ConversationFlagSender", fields: [senderId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ConversationFlagReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([demandeId, createdAt])
  @@index([status, createdAt])
}

// IA-8 — catégories de signaux (documentées : un signal n'est jamais une
// preuve — OFF_PLATFORM_* exigent un contexte de contournement, une simple
// mention de numéro/moyen de contact ne suffit pas).
enum AiConversationCategory {
  OFF_PLATFORM_PAYMENT
  OFF_PLATFORM_CONTACT
  CONVERSATION_INCONSISTENCY
  PRICE_DISCREPANCY
  POTENTIAL_FRAUD
  ABUSIVE_OR_PRESSURING_BEHAVIOR
  OTHER
}

// IA-8 — sévérité = priorité de revue humaine (HIGH n'est jamais une
// fraude confirmée).
enum AiConversationSeverity {
  LOW
  MEDIUM
  HIGH
}

// IA-8 — OPEN : à examiner ; REVIEWED : examiné ; DISMISSED : non pertinent
// (l'historique est toujours conservé).
enum AiConversationFlagStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model Quote {
  id           String      @id @default(dbgenerated("gen_random_uuid()"))
  demandeId    String
  technicianId String
  amount       Int
  currency     String      @default("XAF")
  description  String
  status       QuoteStatus @default(PENDING)
  // Origine du prix (Sprint 8.1).
  // MANUAL : saisi par le technicien (fallback contrôlé) — comportement historique.
  // CATALOG : généré automatiquement par RepairDom depuis le Pricing catalogue
  // (snapshot figé, indépendant des modifications ultérieures du catalogue).
  source                QuoteSource @default(MANUAL)
  // Sprint 8.6 : lien au diagnostic de mission qui motive ce tarif. Permet de
  // relier chaque proposition (CATALOG ou MANUAL) à son diagnostic (mode,
  // intervention proposée, justification, notes). NULL pour les propositions
  // créées avant le Sprint 8.6 (aucun diagnostic n'existait encore).
  diagnosticId          String?
  catalogDiagnosticId   String?
  catalogInterventionId String?
  initialReferencePrice Int?
  initialTravelFee      Int?
  initialServiceFee     Int?
  // Sprint 8.7-FIN — composante « transport » du tarif total. Renseigné pour
  // les quotes CATALOG (snapshot initialTravelFee) et pour les quotes MANUAL
  // (travelAmount saisi par le technicien, sinon 0). Règle :
  //   repairAmount = Quote.amount - travelAmount ; travelAmount >= 0.
  // Le transport appartient à 100 % au technicien et n'est jamais soumis aux
  // frais RepairDom.
  travelAmount  Int?
  createdAt    DateTime    @default(now())

  demande    Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  diagnostic Diagnostic?       @relation(fields: [diagnosticId], references: [id], onDelete: SetNull)
  catalogDiagnostic   CatalogDiagnostic?   @relation(fields: [catalogDiagnosticId], references: [id], onDelete: SetNull)
  catalogIntervention CatalogIntervention? @relation(fields: [catalogInterventionId], references: [id], onDelete: SetNull)
  // IA-6 — contrôle tarifaire immuable (un par devis, jamais réécrit).
  pricingCheck QuotePricingCheck?
  // IA-7 — avertissements issus du contrôle (historique immuable).
  aiWarnings AiWarning[]

  @@index([demandeId])
  @@index([diagnosticId])
  @@index([catalogDiagnosticId])
  @@index([catalogInterventionId])
}

