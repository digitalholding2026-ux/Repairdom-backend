// Familles d'équipements du parcours « Autre appareil » — source de vérité
// unique des indices structurés (familles compréhensibles + « Je ne sais
// pas »). Chaque famille pointe vers UNE catégorie métier de dispatch
// (ALLOWED_CATEGORIES) : une demande avec cette famille est dispatchée
// comme cette catégorie, via le matching existant (aucune IA, aucune
// logique parallèle). Gérée par l'admin (CRUD catalogue) ; `code` stable,
// `label` affichable, désactivation sans suppression d'historique (les
// demandes gardent leur code en texte).
model EquipmentFamily {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  code      String   @unique
  label     String
  icon      String?
  category  String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ServiceDomain {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  slug        String   @unique
  description String?
  icon        String?
