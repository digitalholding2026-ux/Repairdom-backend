generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  TECHNICIAN
}

enum DemandeStatus {
  SUBMITTED
  PENDING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  CANCELED
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                  String              @id @default(dbgenerated("gen_random_uuid()"))
  role                Role                @default(CLIENT)
  firstName           String
  lastName            String?
  phone               String?
  email               String              @unique
  passwordHash        String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  demandes            Demande[]           @relation("ClientDemandes")
  technicianDemandes  Demande[]           @relation("TechnicianDemandes")
  technicianProfile   TechnicianProfile?
  messages            Message[]
  diagnostics         Diagnostic[]
  quotes              Quote[]
}

model Demande {
  id          String        @id @default(dbgenerated("gen_random_uuid()"))
  reference   String        @unique
  status      DemandeStatus @default(SUBMITTED)
  category    String
  description String
  city        String
  address     String?
  client      User          @relation("ClientDemandes", fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  technician  User?         @relation("TechnicianDemandes", fields: [technicianId], references: [id], onDelete: SetNull)
  technicianId String?
  scheduledAt DateTime?
  medias      DemandeMedia[]
  messages    Message[]
  diagnostics Diagnostic[]
  quotes      Quote[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@index([technicianId])
  @@index([status])
}

model TechnicianProfile {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city       String
  categories String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DemandeMedia {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  kind      MediaKind
  fileName  String
  mimeType  String
  sizeBytes Int
  stored    Boolean   @default(false)
  url       String?
  demande   Demande   @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  demandeId String
  createdAt DateTime  @default(now())

  @@index([demandeId])
}

model Message {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  demande Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([demandeId])
  @@index([senderId])
}

model Diagnostic {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  demandeId      String
  technicianId   String
  content        String
  recommendation String?
  createdAt      DateTime @default(now())

  demande    Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([demandeId])
}

model Quote {
  id           String      @id @default(dbgenerated("gen_random_uuid()"))
  demandeId    String
  technicianId String
  amount       Int
  currency     String      @default("XAF")
  description  String
  status       QuoteStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  demande    Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([demandeId])
}